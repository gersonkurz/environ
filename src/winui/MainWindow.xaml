<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EnvironApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="environ">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Single-row unified Title Bar: title + badge, MenuBar, compact toolbar, Run as admin, caption inset -->
        <Grid x:Name="TitleBarRow" Grid.Row="0" MinHeight="48" SizeChanged="OnTitleBarLayoutChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,6,0">
                <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="RoleBadge" CornerRadius="4" Padding="7,2" VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock x:Name="RoleBadgeText" FontSize="11" Opacity="0.88" />
                </Border>
            </StackPanel>

            <MenuBar x:Name="MainMenu" Grid.Column="1" VerticalAlignment="Center">
                <MenuBarItem Title="File" AccessKey="F">
                    <MenuFlyoutItem x:Name="MenuSaveItem" Text="Save Changes" Click="OnSaveClick" KeyboardAcceleratorTextOverride="Ctrl+S" IsEnabled="False">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Refresh" Click="OnRefreshClick" KeyboardAcceleratorTextOverride="F5">
                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Export TOML..." Click="OnExportClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Import TOML..." Click="OnImportClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="MenuElevateItem" Text="Restart as Administrator" Click="OnRunAsAdminClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA18;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="OnExitClick" KeyboardAcceleratorTextOverride="Alt+F4" />
                </MenuBarItem>

                <MenuBarItem Title="Edit" AccessKey="E">
                    <MenuFlyoutItem Text="New User Variable" Click="OnNewUserVarClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuNewMachineVar" Text="New Machine Variable" Click="OnNewMachineVarClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Delete Variable" Click="OnDeleteVarClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Insert Path Entry" Click="OnInsertEntryClick" KeyboardAcceleratorTextOverride="Ins" />
                    <MenuFlyoutItem Text="Remove Path Entry" Click="OnRemoveEntryClick" KeyboardAcceleratorTextOverride="Del" />
                    <MenuFlyoutItem Text="Move Entry Up" Click="OnMoveEntryUpClick" KeyboardAcceleratorTextOverride="Alt+Up" />
                    <MenuFlyoutItem Text="Move Entry Down" Click="OnMoveEntryDownClick" KeyboardAcceleratorTextOverride="Alt+Down" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Copy" Click="OnCopyClick" KeyboardAcceleratorTextOverride="Ctrl+C">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>

                <MenuBarItem Title="View" AccessKey="V">
                    <MenuFlyoutItem Text="History..." Click="OnHistoryClick" KeyboardAcceleratorTextOverride="Ctrl+H">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Theme..." Click="OnThemesClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Font..." Click="OnFontsClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Zoom In" Click="OnZoomInClick" KeyboardAcceleratorTextOverride="Ctrl++" />
                    <MenuFlyoutItem Text="Zoom Out" Click="OnZoomOutClick" KeyboardAcceleratorTextOverride="Ctrl+-" />
                    <MenuFlyoutItem Text="Reset Zoom (100%)" Click="OnZoomResetClick" KeyboardAcceleratorTextOverride="Ctrl+0" />
                </MenuBarItem>

                <MenuBarItem Title="Help" AccessKey="H">
                    <MenuFlyoutItem Text="About environ..." Click="OnAboutClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>
            </MenuBar>

            <!-- Compact inline toolbar in the title bar -->
            <StackPanel x:Name="ToolBar" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,8,0">
                <Button x:Name="SaveButton"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Review and save changes (Ctrl+S)"
                        Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock x:Name="SaveButtonText" Text="Save" />
                    </StackPanel>
                </Button>

                <Button x:Name="RefreshButton"
                        ToolTipService.ToolTip="Reload from registry (F5)"
                        Click="OnRefreshClick">
                    <SymbolIcon Symbol="Refresh" />
                </Button>

                <Button x:Name="HistoryButton"
                        ToolTipService.ToolTip="Snapshot history (Ctrl+H)"
                        Click="OnHistoryClick">
                    <FontIcon Glyph="&#xE81C;" FontSize="14" />
                </Button>

                <DropDownButton x:Name="NewVarButton" ToolTipService.ToolTip="Create a new variable">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="New" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="New user variable" Click="OnNewUserVarClick" />
                            <MenuFlyoutItem x:Name="DropDownNewMachineVar" Text="New machine variable" Click="OnNewMachineVarClick" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <TextBox x:Name="SearchBox"
                         Width="240"
                         PlaceholderText="Filter (Ctrl+F)"
                         IsSpellCheckEnabled="False"
                         VerticalAlignment="Center"
                         TextChanged="OnSearchTextChanged"
                         PreviewKeyDown="OnSearchPreviewKeyDown" />
            </StackPanel>

            <!-- Run as Administrator button (hidden when elevated) -->
            <Button x:Name="RunAsAdminButton"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Margin="0,2,8,2"
                    ToolTipService.ToolTip="Restart environ as administrator to edit machine variables"
                    Click="OnRunAsAdminClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEA18;" FontSize="15" />
                    <TextBlock Text="Run as administrator" />
                </StackPanel>
            </Button>

            <!-- Caption button spacer (updated dynamically from AppWindow.TitleBar.RightInset) -->
            <Border x:Name="CaptionInset" Grid.Column="4" Width="138" />
        </Grid>

        <!-- Primary Variables Grid (full window body) -->
        <Grid x:Name="GridPanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Sticky Sortable Header + Resizable NAME Splitter (right margin matches 12px vertical scrollbar track) -->
            <Border x:Name="GridHeaderBorder" Grid.Row="0" BorderThickness="0,1,0,1">
                <Grid x:Name="GridHeaderRow" Height="30" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeaderNameCol" Width="260" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="NameHeaderButton"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,0,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Content="NAME  &#x25B2;"
                            Click="OnNameHeaderClick" />

                    <Border x:Name="NameSplitter"
                            Grid.Column="1"
                            Background="Transparent"
                            Width="6"
                            PointerPressed="OnSplitterPointerPressed"
                            PointerMoved="OnSplitterPointerMoved"
                            PointerReleased="OnSplitterPointerReleased"
                            PointerCaptureLost="OnSplitterPointerCaptureLost">
                        <Border Width="1" HorizontalAlignment="Center" Opacity="0.35"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Border>

                    <Button x:Name="ValueHeaderButton"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,0,12,0"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Content="VALUE"
                            Click="OnValueHeaderClick" />
                </Grid>
            </Border>

            <!-- Virtualized ListView with dedicated non-overlaying vertical scrollbar track -->
            <ListView x:Name="EnvListView"
                      Grid.Row="1"
                      SelectionMode="Extended"
                      IsMultiSelectCheckBoxEnabled="False"
                      ShowsScrollingPlaceholders="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ContainerContentChanging="OnContainerContentChanging"
                      SelectionChanged="OnListSelectionChanged"
                      DoubleTapped="OnListDoubleTapped"
                      RightTapped="OnListRightTapped"
                      SizeChanged="OnListSizeChanged">
                <ListView.Resources>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid ColumnDefinitions="*,12" Background="{TemplateBinding Background}">
                                        <ScrollContentPresenter x:Name="ScrollContentPresenter"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                Margin="{TemplateBinding Padding}" />
                                        <ScrollBar x:Name="VerticalScrollBar"
                                                   Grid.Column="1"
                                                   Orientation="Vertical"
                                                   IndicatorMode="MouseIndicator"
                                                   IsTabStop="False"
                                                   Maximum="{TemplateBinding ScrollableHeight}"
                                                   Value="{TemplateBinding VerticalOffset}"
                                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset" CacheLength="1" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="24" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Shared Bottom Horizontal ScrollBar under VALUE column -->
            <ScrollBar x:Name="ValueHScrollBar"
                       Grid.Row="2"
                       Orientation="Horizontal"
                       IndicatorMode="MouseIndicator"
                       Margin="266,0,12,0"
                       Minimum="0"
                       Maximum="0"
                       SmallChange="32"
                       LargeChange="160"
                       Visibility="Collapsed"
                       ValueChanged="OnHScrollValueChanged" />
        </Grid>

        <!-- Status Footer -->
        <Border x:Name="StatusFooter" Grid.Row="2" Padding="12,0" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Opacity="0.85" />
                <TextBlock x:Name="StatusHintText"
                           Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Opacity="0.85"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
